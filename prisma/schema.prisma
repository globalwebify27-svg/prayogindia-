// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Staff / Operations Roles
// ─────────────────────────────────────────────
enum StaffRole {
  SUPER_ADMIN
  STORE_MANAGER
  KIOSK_USER
}

enum StaffStatus {
  ACTIVE
  SUSPENDED
}

// ─────────────────────────────────────────────
// Physical Store / Branch
// ─────────────────────────────────────────────
model Store {
  id                   String      @id @default(uuid())
  code                 String      @unique // e.g. RANCHI, PATNA, DELHI
  name                 String
  type                 String      @default("Physical Branch Store")
  isCentralHub         Boolean     @default(false)
  address              String
  city                 String
  state                String
  pincode              String
  contactPhone         String
  contactEmail         String
  operatingHours       String      @default("10:00 AM - 8:00 PM")
  status               String      @default("Operational") // Operational | Coming Soon | Maintenance
  totalStockUnits      Int         @default(0)
  monthlyWalkInRevenue Float       @default(0)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  staff                StaffUser[]

  @@index([code])
}

// ─────────────────────────────────────────────
// Staff User Model (Admin / Manager / Kiosk)
// Completely separate from the Customer User model
// ─────────────────────────────────────────────
model StaffUser {
  id           String      @id @default(uuid())
  name         String
  email        String?     @unique
  username     String      @unique
  passwordHash String
  role         StaffRole
  storeId      String?     // NULL for SUPER_ADMIN
  store        Store?      @relation(fields: [storeId], references: [id], onDelete: SetNull)
  phone        String?
  status       StaffStatus @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([username])
  @@index([storeId])
  @@index([role])
}

// ─────────────────────────────────────────────
// Customer Roles (unchanged)
// ─────────────────────────────────────────────
enum Role {
  CUSTOMER
  ADMIN
}

enum CustomerType {
  B2C
  B2B
  WALK_IN
  REGISTERED
  GUEST
}

enum OrderStatus {
  ORDER_PLACED
  PAYMENT_CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketCategory {
  HARDWARE_INQUIRY
  LAB_SETUP
  ORDER_TRACKING
  TECHNICAL_SUPPORT
}

enum ServiceSlug {
  STEM_LAB_SETUP
  ROBOTICS_LAB_SETUP
  DRONE_LAB_SETUP
  INDUSTRIAL_PROJECTS
  CONSULTANCY
}

// 1. Customer User Model
model User {
  id            String          @id @default(uuid())
  name          String
  email         String          @unique
  phone         String
  passwordHash  String
  role          Role            @default(CUSTOMER)
  customerType  CustomerType    @default(B2C)
  companyName   String?
  gstin         String?
  rewardPoints  Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  addresses     Address[]
  carts         Cart[]
  wishlists     Wishlist[]
  orders        Order[]
  enquiries     ServiceEnquiry[]
  tickets       SupportTicket[]
  notifications Notification[]

  @@index([email])
}

// 2. Customer Addresses
model Address {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  phone       String
  street      String
  city        String
  state       String
  pincode     String
  type        String   @default("Home") // Home | Office | Lab / College
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// 3. Category Hierarchy
model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  image       String?
  parentId    String?
  parent      Category?  @relation("SubCategories", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("SubCategories")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  products    Product[]

  @@index([slug])
}

// 4. Products
model Product {
  id             String          @id @default(uuid())
  categoryId     String
  category       Category        @relation(fields: [categoryId], references: [id])
  name           String
  slug           String          @unique
  sku            String          @unique
  description    String
  price          Float
  mrp            Float?
  stock          Int             @default(0)
  inStock        Boolean         @default(true)
  brand          String          @default("Prayog India")
  rating         Float           @default(4.9)
  reviewCount    Int             @default(12)
  specifications Json?
  features       String[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  variants       ProductVariant[]
  images         ProductImage[]
  cartItems      CartItem[]
  wishlistItems  WishlistItem[]
  orderItems     OrderItem[]
  offerProducts  OfferProduct[]

  @@index([slug])
  @@index([categoryId])
}

// 5. Product Variants
model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String   // e.g., "5200mAh / 60C"
  sku       String   @unique
  price     Float
  mrp       Float?
  stock     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]
}

// 6. Product Images
model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl  String
  altText   String?
  sortOrder Int      @default(0)
}

// 7. Cart & Cart Items
model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  items     CartItem[]
}

model CartItem {
  id        String          @id @default(uuid())
  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int             @default(1)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([cartId, productId, variantId])
}

// 8. Wishlist & Wishlist Items
model Wishlist {
  id        String         @id @default(uuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  items     WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([wishlistId, productId])
}

// 9. Orders & Order Items
model Order {
  id              String       @id @default(uuid())
  orderNumber     String       @unique
  userId          String
  user            User         @relation(fields: [userId], references: [id])
  customerType    CustomerType @default(B2C)
  status          OrderStatus  @default(ORDER_PLACED)
  totalAmount     Float
  subtotal        Float
  gstAmount       Float
  discountAmount  Float       @default(0)
  shippingAddress String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items           OrderItem[]
  shipment        Shipment?

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id          String          @id @default(uuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  productName String          // Historical Snapshot
  productSku  String          // Historical Snapshot
  price       Float           // Purchase Price Snapshot
  quantity    Int
}

// 10. Shipment Tracking
model Shipment {
  id              String    @id @default(uuid())
  orderId         String    @unique
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courierName     String
  trackingNumber  String
  trackingUrl     String?
  status          String    @default("In Transit")
  estimatedDelivery String?
  shippedAt       DateTime  @default(now())
}

// 11. Services & Institutional Enquiries
model Service {
  id               String      @id @default(uuid())
  slug             ServiceSlug @unique
  name             String
  shortDescription String
  description      String
  bannerImage      String
  features         String[]
  applications     String[]
  gallery          String[]

  enquiries        ServiceEnquiry[]
}

model ServiceEnquiry {
  id          String   @id @default(uuid())
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id])
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  name        String
  phone       String
  email       String
  message     String
  createdAt   DateTime @default(now())
}

// 12. Learning Hub Content
model LearningContent {
  id               String   @id @default(uuid())
  slug             String   @unique
  title            String
  category         String
  readTime         String
  level            String
  shortDescription String
  bannerImage      String
  content          String
  relatedProductIds String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([slug])
}

// 13. Offers & Promotional Campaigns
model Offer {
  id                  String   @id @default(uuid())
  slug                String   @unique
  title               String
  shortDescription    String
  image               String
  badge               String   // FEATURED | ACTIVE | UPCOMING
  status              String   // Active | Upcoming | Expired
  startDate           String
  endDate             String
  couponCode          String?
  customerEligibility String?

  products            OfferProduct[]

  @@index([slug])
}

model OfferProduct {
  offerId   String
  offer     Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([offerId, productId])
}

// 14. Support Tickets & Messages
model SupportTicket {
  id           String         @id @default(uuid())
  ticketNumber String         @unique
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject      String
  category     TicketCategory
  status       TicketStatus   @default(OPEN)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  messages     SupportMessage[]

  @@index([userId])
}

model SupportMessage {
  id        String        @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender    String        // Customer | Support Desk
  text      String
  createdAt DateTime      @default(now())
}

// 15. Customer Notifications
model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    // ORDER_PLACED | ORDER_SHIPPED | SUPPORT_REPLY | SERVICE_ENQUIRY_RECEIVED
  title     String
  message   String
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([readAt])
  @@index([createdAt])
}
