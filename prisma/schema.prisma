// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Staff / Operations Roles
// ─────────────────────────────────────────────
enum StaffRole {
  SUPER_ADMIN
  REGIONAL_MANAGER
  STORE_MANAGER
  POS_CASHIER
  KIOSK_USER
}

enum StaffStatus {
  ACTIVE
  SUSPENDED
}

// ─────────────────────────────────────────────
// Physical Store / Branch
// ─────────────────────────────────────────────
model Store {
  id                   String      @id @default(uuid())
  code                 String      @unique // e.g. RANCHI, PATNA, DELHI, MUMBAI, KOLKATA
  name                 String
  type                 String      @default("Physical Branch Store")
  isCentralHub         Boolean     @default(false)
  address              String
  city                 String
  state                String
  pincode              String
  contactPhone         String
  contactEmail         String
  operatingHours       String      @default("10:00 AM - 8:00 PM")
  status               String      @default("Operational") // Operational | Coming Soon | Maintenance
  totalStockUnits      Int         @default(0)
  monthlyWalkInRevenue Float       @default(0)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  staff                StaffUser[]
  inventory            StoreInventory[]
  productSettings      StoreProductSettings[]
  devices              Device[]
  transactions         InventoryTransaction[]
  outgoingTransfers    StockTransfer[]        @relation("SourceStore")
  incomingTransfers    StockTransfer[]        @relation("DestinationStore")
  purchaseOrders       PurchaseOrder[]
  quotations           Quotation[]
  b2bCompanies         B2BCompany[]
  auditLogs            AuditLog[]

  @@index([code])
}

// ─────────────────────────────────────────────
// Store-Specific Inventory (UNIQUE per Store + Product)
// ─────────────────────────────────────────────
model StoreInventory {
  id                 String   @id @default(uuid())
  storeId            String
  store              Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity           Int      @default(0)
  reservedQuantity   Int      @default(0)
  availableQuantity  Int      @default(0)
  reorderLevel       Int      @default(10)
  lowStockThreshold  Int      @default(5)
  status             String   @default("IN_STOCK") // IN_STOCK | LOW_STOCK | OUT_OF_STOCK
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([storeId, productId])
  @@index([storeId])
  @@index([productId])
}

// ─────────────────────────────────────────────
// Store-Specific Product Settings / Price Overrides
// ─────────────────────────────────────────────
model StoreProductSettings {
  id               String   @id @default(uuid())
  storeId          String
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  isEnabled        Boolean  @default(true)
  isVisible        Boolean  @default(true)
  priceOverride    Float?   // Optional store-specific pricing
  reorderLevel     Int?
  storeTaxOverride Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([storeId, productId])
  @@index([storeId])
  @@index([productId])
}

// ─────────────────────────────────────────────
// Store POS Devices & Kiosks
// ─────────────────────────────────────────────
model Device {
  id          String    @id @default(uuid())
  deviceCode  String    @unique // e.g. TAB-RNC-01, POS-PAT-01
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  deviceName  String
  deviceType  String    @default("POS_TERMINAL") // POS_TERMINAL | KIOSK_TABLET | MANAGER_DESKTOP
  status      String    @default("ACTIVE") // ACTIVE | INACTIVE | REVOKED
  lastLogin   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  transactions InventoryTransaction[]

  @@index([deviceCode])
  @@index([storeId])
}

// ─────────────────────────────────────────────
// Complete Inventory Audit Trail / Transactions Log
// ─────────────────────────────────────────────
model InventoryTransaction {
  id              String   @id @default(uuid())
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId         String?
  transactionType String   // SALE | RESTOCK | TRANSFER_IN | TRANSFER_OUT | ADJUSTMENT | RETURN | ONLINE_FULFILLMENT
  quantityBefore  Int
  quantityChange  Int
  quantityAfter   Int
  userId          String?
  deviceId        String?
  device          Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  referenceId     String?
  notes           String?
  createdAt       DateTime @default(now())

  @@index([storeId])
  @@index([productId])
  @@index([transactionType])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// Inter-Store Stock Transfers
// ─────────────────────────────────────────────
model StockTransfer {
  id                 String              @id @default(uuid())
  transferNumber     String              @unique // e.g. TR-20260902-001
  sourceStoreId      String
  sourceStore        Store               @relation("SourceStore", fields: [sourceStoreId], references: [id])
  destinationStoreId String
  destinationStore   Store               @relation("DestinationStore", fields: [destinationStoreId], references: [id])
  status             String              @default("PENDING") // PENDING | IN_TRANSIT | COMPLETED | CANCELLED
  requestedByUserId  String?
  approvedByUserId   String?
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  items              StockTransferItem[]

  @@index([transferNumber])
  @@index([sourceStoreId])
  @@index([destinationStoreId])
}

model StockTransferItem {
  id               String        @id @default(uuid())
  transferId       String
  transfer         StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId        String
  product          Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity         Int
  receivedQuantity Int           @default(0)
}

// ─────────────────────────────────────────────
// Staff User Model (Admin / Manager / Kiosk)
// Completely separate from the Customer User model
// ─────────────────────────────────────────────
model StaffUser {
  id           String      @id @default(uuid())
  name         String
  email        String?     @unique
  username     String      @unique
  passwordHash String
  role         StaffRole
  storeId      String?     // NULL for SUPER_ADMIN
  store        Store?      @relation(fields: [storeId], references: [id], onDelete: SetNull)
  phone        String?
  status       StaffStatus @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  assignedCompanies B2BCompany[]
  assignedFollowUps B2BFollowUp[]

  @@index([username])
  @@index([storeId])
  @@index([role])
}

// ─────────────────────────────────────────────
// Customer Roles (unchanged)
// ─────────────────────────────────────────────
enum Role {
  CUSTOMER
  ADMIN
}

enum CustomerType {
  B2C
  B2B
  WALK_IN
  REGISTERED
  GUEST
}

enum OrderStatus {
  ORDER_PLACED
  PAYMENT_CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  PAYMENT_FAILED
  RETURN_REQUESTED
  RETURNED
  REFUND_INITIATED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIAL_REFUNDED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketCategory {
  HARDWARE_INQUIRY
  LAB_SETUP
  ORDER_TRACKING
  TECHNICAL_SUPPORT
}

enum ServiceSlug {
  STEM_LAB_SETUP
  ROBOTICS_LAB_SETUP
  DRONE_LAB_SETUP
  INDUSTRIAL_PROJECTS
  CONSULTANCY
}

// 1. Customer User Model
model User {
  id            String          @id @default(uuid())
  name          String
  email         String          @unique
  phone         String
  passwordHash  String
  role          Role            @default(CUSTOMER)
  customerType  CustomerType    @default(B2C)
  companyName   String?
  gstin         String?
  rewardPoints  Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  addresses          Address[]
  carts              Cart[]
  wishlists          Wishlist[]
  orders             Order[]
  enquiries          ServiceEnquiry[]
  tickets            SupportTicket[]
  notifications      Notification[]
  reviews            Review[]
  rewardTransactions RewardTransaction[]
  quotations         Quotation[]

  @@index([email])
  @@index([phone])
}

// 2. Customer Addresses
model Address {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  phone       String
  street      String
  city        String
  state       String
  pincode     String
  type        String   @default("Home") // Home | Office | Lab / College
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// 3. Category Hierarchy
model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  image       String?
  parentId    String?
  parent      Category?  @relation("SubCategories", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("SubCategories")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  products    Product[]

  @@index([slug])
}

// 4. Products
model Product {
  id             String          @id @default(uuid())
  categoryId     String
  category       Category        @relation(fields: [categoryId], references: [id])
  name           String
  slug           String          @unique
  sku            String          @unique
  description    String
  price          Float
  mrp            Float?
  gstRate        Float           @default(18) // GST percentage per product (e.g., 18 for 18%)
  weight         Float           @default(0)  // Weight in grams for shipping calculation
  stock          Int             @default(0)
  inStock        Boolean         @default(true)
  brand          String          @default("Prayog India")
  rating         Float           @default(4.9)
  reviewCount    Int             @default(12)
  specifications Json?
  features       String[]
  applications   String[]        // Product application use-cases
  tags           String[]        // Shipping / freight restriction tags (e.g., LITHIUM_BATTERY, HAZARDOUS)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  variants              ProductVariant[]
  images                ProductImage[]
  cartItems             CartItem[]
  wishlistItems         WishlistItem[]
  orderItems            OrderItem[]
  offerProducts         OfferProduct[]
  storeInventory        StoreInventory[]
  storeSettings         StoreProductSettings[]
  inventoryTransactions InventoryTransaction[]
  stockTransferItems    StockTransferItem[]
  reviews               Review[]
  purchaseOrderItems    PurchaseOrderItem[]
  quotationItems        QuotationItem[]

  @@index([slug])
  @@index([categoryId])
  @@index([brand])
}

// 5. Product Variants
model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String   // e.g., "5200mAh / 60C"
  sku       String   @unique
  price     Float
  mrp       Float?
  stock     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]
}

// 6. Product Images
model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl  String
  altText   String?
  sortOrder Int      @default(0)
}

// 7. Cart & Cart Items
model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  items     CartItem[]
}

model CartItem {
  id        String          @id @default(uuid())
  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int             @default(1)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([cartId, productId, variantId])
}

// 8. Wishlist & Wishlist Items
model Wishlist {
  id        String         @id @default(uuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  items     WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([wishlistId, productId])
}

// 9. Orders & Order Items
model Order {
  id                String        @id @default(uuid())
  orderNumber       String        @unique
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  customerType      CustomerType  @default(B2C)
  status            OrderStatus   @default(ORDER_PLACED)
  paymentStatus     PaymentStatus @default(PENDING)
  paymentId         String?       // Payment gateway reference ID
  paymentMethod     String?       // razorpay | cod | bank_transfer
  rewardPointsUsed  Int           @default(0)   // Points redeemed at checkout
  rewardPointsEarned Int          @default(0)   // Points credited on this order
  couponCode        String?       // Applied coupon code snapshot
  couponDiscount    Float         @default(0)   // Coupon discount amount snapshot
  shippingCost      Float         @default(0)
  totalAmount       Float
  subtotal          Float
  gstAmount         Float
  discountAmount    Float         @default(0)
  shippingAddress   String
  cancelledAt       DateTime?
  cancelReason      String?
  refundStatus      String?       // INITIATED | PROCESSED | FAILED
  refundAmount      Float         @default(0)
  refundedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  items             OrderItem[]
  shipment          Shipment?
  payment           Payment?
  invoice           Invoice?
  reviews           Review[]
  quotationId       String?       @unique
  quotation         Quotation?    @relation(fields: [quotationId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([orderNumber])
}

model OrderItem {
  id          String          @id @default(uuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  productName String          // Historical Snapshot
  productSku  String          // Historical Snapshot
  price       Float           // Purchase Price Snapshot
  quantity    Int
}

// 10. Shipment Tracking
model Shipment {
  id                  String    @id @default(uuid())
  orderId             String    @unique
  order               Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courierName         String
  courierCode         String    @default("DELHIVERY")
  trackingNumber      String    // AWB number
  trackingUrl         String?
  labelUrl            String?
  status              String    @default("Manifest Created")
  estimatedDelivery   String?
  weightKg            Float?    @default(0.5)
  trackingEvents      Json?     // Array of { timestamp, location, status, message }
  lastTrackingUpdate  DateTime  @default(now())
  shippedAt           DateTime  @default(now())
  deliveredAt         DateTime?
  rtoReason           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// 11. Services & Institutional Enquiries
model Service {
  id               String      @id @default(uuid())
  slug             ServiceSlug @unique
  name             String
  shortDescription String
  description      String
  bannerImage      String
  features         String[]
  applications     String[]
  gallery          String[]

  enquiries        ServiceEnquiry[]
}

model ServiceEnquiry {
  id          String   @id @default(uuid())
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id])
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  name        String
  phone       String
  email       String
  message     String
  createdAt   DateTime @default(now())
}

// 12. Learning Hub Content
model LearningContent {
  id               String   @id @default(uuid())
  slug             String   @unique
  title            String
  category         String
  readTime         String
  level            String
  shortDescription String
  bannerImage      String
  content          String
  relatedProductIds String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([slug])
}

// 13. Offers & Promotional Campaigns
model Offer {
  id                  String   @id @default(uuid())
  slug                String   @unique
  title               String
  shortDescription    String
  image               String
  badge               String   // FEATURED | ACTIVE | UPCOMING
  status              String   // Active | Upcoming | Expired
  startDate           String
  endDate             String
  couponCode          String?
  customerEligibility String?

  products            OfferProduct[]

  @@index([slug])
}

model OfferProduct {
  offerId   String
  offer     Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([offerId, productId])
}

// 14. Support Tickets & Messages
model SupportTicket {
  id           String         @id @default(uuid())
  ticketNumber String         @unique
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject      String
  category     TicketCategory
  status       TicketStatus   @default(OPEN)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  messages     SupportMessage[]

  @@index([userId])
}

model SupportMessage {
  id        String        @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender    String        // Customer | Support Desk
  text      String
  createdAt DateTime      @default(now())
}

// 15. Customer Notifications
model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    // ORDER_PLACED | ORDER_SHIPPED | SUPPORT_REPLY | SERVICE_ENQUIRY_RECEIVED
  title     String
  message   String
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([readAt])
  @@index([createdAt])
}

// 16. Payment Records
model Payment {
  id              String        @id @default(uuid())
  orderId         String        @unique
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gatewayOrderId  String?       // Razorpay order_id
  gatewayPaymentId String?      // Razorpay payment_id
  gatewaySignature String?      // Razorpay signature for verification
  amount          Float
  currency        String        @default("INR")
  method          String?       // card | upi | netbanking | wallet | emi
  status          PaymentStatus @default(PENDING)
  gatewayResponse Json?         // Full raw gateway response
  verifiedAt      DateTime?
  failureReason   String?
  refundId        String?
  refundAmount    Float         @default(0)
  refundedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([orderId])
  @@index([gatewayPaymentId])
  @@index([status])
}

// 17. Tax Invoices
model Invoice {
  id              String   @id @default(uuid())
  invoiceNumber   String   @unique // e.g., INV-2026-001
  orderId         String   @unique
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId          String
  customerName    String
  customerEmail   String
  customerPhone   String
  customerGstin   String?  // B2B GSTIN
  companyName     String?  // B2B company
  billingAddress  String
  shippingAddress String
  items           Json     // Snapshot of order items with price, qty, GST
  subtotal        Float
  discountAmount  Float    @default(0)
  couponCode      String?
  couponDiscount  Float    @default(0)
  gstBreakup      Json?    // {cgst, sgst, igst} breakdown
  gstAmount       Float
  shippingCost    Float    @default(0)
  totalAmount     Float
  paymentMethod   String?
  paymentRef      String?
  invoiceDate     DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([orderId])
  @@index([invoiceNumber])
  @@index([userId])
}

// 18. Product Reviews
model Review {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId    String?
  order      Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Int      // 1-5
  title      String?
  body       String
  isVerified Boolean  @default(false) // Purchased & delivered order
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([productId, userId])  // One review per product per customer
  @@index([productId])
  @@index([userId])
  @@index([rating])
}

// 19. Reward / Loyalty Point Transactions
model RewardTransaction {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId         String?   // Associated order (if applicable)
  type            String    // EARNED | REDEEMED | EXPIRED | ADJUSTMENT | BONUS | REFUND_REVERSAL
  points          Int       // Positive = earned/added, Negative = redeemed/deducted
  balanceBefore   Int
  balanceAfter    Int
  description     String
  referenceType   String?   // ORDER_PAYMENT | ORDER_CANCEL | ORDER_DELIVERED | CHECKOUT_REDEEM | ADMIN_ADJUSTMENT | REGISTRATION_BONUS | EXPIRY
  referenceId     String?   // E.g. Order ID, Refund ID, Staff ID
  expiryDate      DateTime?
  metadata        Json?     // Extra structured context
  createdAt       DateTime  @default(now())

  @@index([userId])
  @@index([type])
  @@index([orderId])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

// 19b. Configurable Loyalty Tier Rules
model LoyaltyRule {
  id                      String   @id @default(uuid())
  tierCode                String   @unique // B2C | B2B | REGISTERED | WALK_IN
  name                    String
  pointsPer100Spent       Float    @default(1.0)
  redemptionRateRupees    Float    @default(0.5)
  minRedemptionPoints     Int      @default(50)
  maxRedemptionPercentage Float    @default(20.0) // % of subtotal max payable with points
  validityDays            Int      @default(365)
  registrationBonus       Int      @default(100)
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

// 20. Coupon Usage Tracking
model CouponUsage {
  id         String   @id @default(uuid())
  couponCode String
  userId     String
  orderId    String?
  usedAt     DateTime @default(now())

  @@unique([couponCode, userId, orderId])
  @@index([couponCode])
  @@index([userId])
}

// ─────────────────────────────────────────────
// PROCUREMENT / PURCHASE MODULE
// ─────────────────────────────────────────────

enum PurchaseOrderStatus {
  DRAFT
  PENDING
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SupplierPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

// 21. Suppliers
model Supplier {
  id              String   @id @default(uuid())
  name            String
  contactPerson   String?
  phone           String
  email           String?
  address         String?
  city            String?
  state           String?
  pincode         String?
  gstin           String?
  bankName        String?
  bankAccount     String?
  bankIfsc        String?
  notes           String?
  status          String   @default("Active") // Active | Inactive
  totalPurchases  Float    @default(0)
  outstandingAmount Float  @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchaseOrders  PurchaseOrder[]

  @@index([status])
}

// 22. Purchase Orders
model PurchaseOrder {
  id                  String              @id @default(uuid())
  poNumber            String              @unique // e.g. PO-2026-001
  storeId             String
  store               Store               @relation(fields: [storeId], references: [id])
  supplierId          String
  supplier            Supplier            @relation(fields: [supplierId], references: [id])
  status              PurchaseOrderStatus @default(DRAFT)
  orderDate           DateTime            @default(now())
  expectedDelivery    DateTime?
  invoiceNumber       String?             // Supplier invoice ref
  notes               String?
  subtotal            Float               @default(0)
  taxAmount           Float               @default(0)
  shippingCost        Float               @default(0)
  totalAmount         Float               @default(0)
  amountPaid          Float               @default(0)
  amountDue           Float               @default(0)
  paymentStatus       SupplierPaymentStatus @default(UNPAID)
  createdByStaffId    String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  items               PurchaseOrderItem[]
  receipts            GoodsReceipt[]
  payments            SupplierPayment[]

  @@index([poNumber])
  @@index([storeId])
  @@index([supplierId])
  @@index([status])
}

// 23. Purchase Order Line Items
model PurchaseOrderItem {
  id                String        @id @default(uuid())
  purchaseOrderId   String
  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product       @relation(fields: [productId], references: [id])
  productName       String        // Snapshot at time of order
  productSku        String        // Snapshot
  orderedQty        Int
  receivedQty       Int           @default(0)
  pendingQty        Int           @default(0)
  unitPrice         Float         // Purchase cost price per unit
  taxRate           Float         @default(0)  // GST %
  taxAmount         Float         @default(0)
  discountAmount    Float         @default(0)
  totalAmount       Float         // orderedQty * unitPrice + tax - discount
  createdAt         DateTime      @default(now())

  receiptItems      GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@index([productId])
}

// 24. Goods Receipts (each delivery event)
model GoodsReceipt {
  id               String        @id @default(uuid())
  receiptNumber    String        @unique // e.g. GR-2026-001
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  receivedByStaffId String?
  receivedAt       DateTime      @default(now())
  notes            String?
  createdAt        DateTime      @default(now())

  items            GoodsReceiptItem[]

  @@index([purchaseOrderId])
}

model GoodsReceiptItem {
  id                  String          @id @default(uuid())
  goodsReceiptId      String
  goodsReceipt        GoodsReceipt    @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  receivedQty         Int
  createdAt           DateTime        @default(now())

  @@index([goodsReceiptId])
}

// 25. Supplier Payment Records
model SupplierPayment {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  amount          Float
  paymentDate     DateTime      @default(now())
  paymentMethod   String        // BANK_TRANSFER | CHEQUE | CASH | UPI | NEFT | RTGS
  referenceNumber String?       // Bank ref / cheque number
  notes           String?
  recordedByStaffId String?
  createdAt       DateTime      @default(now())

  @@index([purchaseOrderId])
}

// ─────────────────────────────────────────────
// 26. Quotations & B2B Proposals
// ─────────────────────────────────────────────

enum QuotationStatus {
  DRAFT
  REQUESTED
  UNDER_REVIEW
  SENT
  VIEWED
  NEGOTIATION
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
  CANCELLED
}

model Quotation {
  id               String          @id @default(uuid())
  quoteNumber      String          @unique // e.g. PRG-QT-2026-0042
  userId           String?
  user             User?           @relation(fields: [userId], references: [id])
  storeId          String
  store            Store           @relation(fields: [storeId], references: [id])

  institutionType  String          @default("Corporate") // School | College | University | STEM Lab | Corporate | Industrial | Government / Tender
  companyName      String
  customerName     String
  customerEmail    String
  customerPhone    String
  gstin            String?
  billingAddress   String?
  shippingAddress  String?

  status           QuotationStatus @default(REQUESTED)
  validUntil       DateTime
  
  subtotal         Float           @default(0)
  discountAmount   Float           @default(0)
  taxRate          Float           @default(18) // %
  taxAmount        Float           @default(0)
  shippingCharge   Float           @default(0)
  grandTotal       Float           @default(0)

  notes            String?
  terms            String?
  adminNotes       String?
  customerFeedback String?

  order            Order?
  convertedAt      DateTime?
  createdByStaffId String?

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  items            QuotationItem[]
  revisions        QuotationRevision[]

  @@index([storeId])
  @@index([userId])
  @@index([status])
  @@index([quoteNumber])
}

model QuotationItem {
  id             String         @id @default(uuid())
  quotationId    String
  quotation      Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?       @relation(fields: [productId], references: [id])
  variantId      String?
  
  productName    String
  productSku     String
  quantity       Int            @default(1)
  unitPrice      Float          // Negotiated B2B unit price
  discountPct    Float          @default(0)
  taxRate        Float          @default(18)
  total          Float          // Computed line total

  createdAt      DateTime       @default(now())

  @@index([quotationId])
  @@index([productId])
}

model QuotationRevision {
  id             String    @id @default(uuid())
  quotationId    String
  quotation      Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  revisionNumber Int
  snapshotJson   String    // Full serialized state of the quotation at revision
  changedByRole  String    // CUSTOMER | STAFF | SYSTEM
  changeNotes    String?
  createdAt      DateTime  @default(now())

  @@index([quotationId])
}

// ─────────────────────────────────────────────
// 27. B2B Relationships & CRM
// ─────────────────────────────────────────────

enum B2BRelationshipStatus {
  LEAD
  PROSPECT
  NEGOTIATION
  ACTIVE_CUSTOMER
  INACTIVE
  LOST
  BLOCKED
}

enum B2BFollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
  OVERDUE
}

model B2BCompany {
  id              String                @id @default(uuid())
  name            String                @unique // e.g. ABC Hotel Group / IIT Delhi Robotics Lab
  companyType     String                @default("Corporate") // School | College | University | STEM Lab | Corporate | Industrial | Government
  industry        String?               // Education | Hospitality | Defense | Drone & UAV | Manufacturing | R&D
  gstin           String?
  website         String?
  email           String?
  phone           String?
  
  billingAddress  String?
  shippingAddress String?
  city            String?
  state           String?
  pincode         String?

  status          B2BRelationshipStatus @default(LEAD)
  assignedStoreId String?
  store           Store?                @relation(fields: [assignedStoreId], references: [id], onDelete: SetNull)
  assignedStaffId String?
  assignedStaff   StaffUser?            @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)

  notes           String?
  rating          Int                   @default(3) // 1-5 Relationship health / VIP priority score
  totalBusiness   Float                 @default(0) // Lifetime realized revenue

  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  contacts        B2BContact[]
  activities      B2BActivity[]
  followUps       B2BFollowUp[]

  @@index([status])
  @@index([assignedStoreId])
  @@index([name])
}

model B2BContact {
  id          String     @id @default(uuid())
  companyId   String
  company     B2BCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  name        String     // e.g. Rahul Sharma
  designation String?    // e.g. Purchase Manager / Lab Director
  phone       String
  email       String?
  contactType String     @default("PURCHASE") // PURCHASE | ACCOUNTS | MANAGEMENT | TECHNICAL
  isPrimary   Boolean    @default(false)
  notes       String?

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  activities  B2BActivity[]
  followUps   B2BFollowUp[]

  @@index([companyId])
}

model B2BActivity {
  id                 String      @id @default(uuid())
  companyId          String
  company            B2BCompany  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId          String?
  contact            B2BContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  activityType       String      // CALL | EMAIL | MEETING | NOTE | QUOTE_EVENT | ORDER_EVENT | FOLLOW_UP
  title              String
  description        String?
  performedByStaffId String?

  createdAt          DateTime    @default(now())

  @@index([companyId])
}

model B2BFollowUp {
  id              String            @id @default(uuid())
  companyId       String
  company         B2BCompany        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId       String?
  contact         B2BContact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedStaffId String?
  assignedStaff   StaffUser?        @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)

  dueDate         DateTime
  reason          String            // e.g. Discuss bulk 20L water jar supply contract
  notes           String?
  status          B2BFollowUpStatus @default(PENDING)

  createdAt       DateTime          @default(now())
  completedAt     DateTime?

  @@index([companyId])
  @@index([status])
  @@index([dueDate])
}

// ─────────────────────────────────────────────
// 28. Central System Audit & Activity Log
// ─────────────────────────────────────────────

enum AuditActionCategory {
  AUTH
  USER_MANAGEMENT
  STORE_MANAGEMENT
  PRODUCT_CATALOG
  CATEGORY_MANAGEMENT
  INVENTORY
  ORDER_FULFILLMENT
  PAYMENT_FINANCE
  SUPPLIER_PROCUREMENT
  QUOTATION_B2B
  CRM_RELATIONSHIPS
  SYSTEM_SECURITY
}

model AuditLog {
  id             String              @id @default(uuid())
  actionCategory AuditActionCategory
  action         String              // e.g. "PRICE_CHANGE", "ORDER_STATUS_UPDATE", "STOCK_ADJUSTMENT", "LOGIN"
  entityType     String              // e.g. "Product", "Order", "Quotation", "Store", "StaffUser", "Supplier"
  entityId       String?
  description    String              // Human-readable narrative

  actorId        String?             // Staff or User ID
  actorName      String              // Snapshot of name
  actorRole      String              // "SUPER_ADMIN", "STORE_MANAGER", "SYSTEM", etc.
  actorEmail     String?

  storeId        String?
  store          Store?              @relation(fields: [storeId], references: [id], onDelete: SetNull)

  previousValue  String?             // JSON snapshot or string representation
  newValue       String?             // JSON snapshot or string representation
  metadata       Json?               // Structured context: headers, reason, related IDs

  ipAddress      String?
  userAgent      String?

  createdAt      DateTime            @default(now())

  @@index([actionCategory])
  @@index([action])
  @@index([entityType, entityId])
  @@index([storeId])
  @@index([actorId])
  @@index([createdAt])
}

